---
// index.astro - CineVault Landing Page
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import FilmCatalog from '../components/FilmCatalog.astro';
import FilmModal from '../components/FilmModal.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="CineVault | Platform Katalog Film, Jurnal Menonton & Ulasan Komunitas"
  description="Ruang digital elegan untuk mencatat film yang telah ditonton, membagikan ulasan personal, dan menjelajahi arsip sinema lintas dekade dengan antarmuka yang bersih."
>
  <Navbar />
  
  <main id="main-content" class="flex-1">
    <Hero />
    <About />
    <FilmCatalog />
    <Testimonials />
    <ContactSection />
  </main>

  <Footer />

  <!-- Global Film Detail Modal Drawer -->
  <FilmModal />
</Layout>
