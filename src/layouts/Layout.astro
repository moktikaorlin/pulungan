---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CineVault | Platform Katalog Film, Jurnal Menonton & Komunitas Cinephile",
  description = "CineVault adalah ruang digital elegan untuk mencatat riwayat tontonan, membaca ulasan sinema independen, dan berdiskusi langsung dengan kurator via WhatsApp."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23F59E0B'><path d='M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#090A0F" />

    <!-- Google Fonts: Cinzel, Outfit, Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#090A0F] text-[#F3F4F6] antialiased selection:bg-[#F59E0B]/20 selection:text-[#F59E0B]">
    <div class="relative min-h-screen flex flex-col overflow-x-hidden">
      <!-- Ambient atmospheric cinema lighting -->
      <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 pointer-events-none opacity-30 z-0 bg-[radial-gradient(ellipse_at_top,_rgba(245,158,11,0.15),transparent_70%)]" aria-hidden="true"></div>
      
      <div class="relative z-10 flex-1 flex flex-col">
        <slot />
      </div>
    </div>
  </body>
</html>
