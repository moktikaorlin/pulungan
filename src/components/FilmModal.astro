---
// FilmModal.astro - Laci Detail & Ulasan Film (Modal Dialog)
---

<div
  id="film-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/80 backdrop-blur-sm transition-opacity duration-300 p-4 sm:p-6 md:p-10 flex items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-film-title"
>
  <!-- Modal Content Container -->
  <div
    id="modal-card"
    class="relative w-full max-w-3xl rounded-2xl border border-[#263042] bg-[#161B26] p-6 sm:p-8 text-left shadow-2xl shadow-black max-h-[90vh] overflow-y-auto transform transition-all duration-300 scale-95 opacity-0"
  >
    <!-- Close Button -->
    <button
      id="close-modal-btn"
      type="button"
      aria-label="Tutup jendela detail film"
      class="absolute top-4 right-4 z-10 flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-[#263042] bg-[#090A0F] text-[#9CA3AF] hover:text-[#F3F4F6] hover:border-amber-400 focus-visible:ring-2 focus-visible:ring-amber-400 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-start">
      
      <!-- Left Column: Poster & Metadata (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <div class="relative aspect-[2/3] w-full rounded-xl overflow-hidden bg-[#090A0F] border border-[#263042]">
          <img
            id="modal-poster"
            src=""
            alt=""
            width="400"
            height="600"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-3 right-3 flex items-center gap-1 rounded-md bg-amber-500 px-2.5 py-1 text-xs font-bold text-[#090A0F] shadow">
            <span>★</span>
            <span id="modal-rating">0.0</span>
          </div>
        </div>

        <div class="rounded-lg bg-[#090A0F] p-3 text-xs text-[#9CA3AF] space-y-1.5 border border-[#263042]/50">
          <div class="flex justify-between">
            <span>Sutradara:</span>
            <strong id="modal-director" class="text-[#F3F4F6] font-medium">-</strong>
          </div>
          <div class="flex justify-between">
            <span>Tahun Rilis:</span>
            <span id="modal-year" class="text-[#F3F4F6] font-medium">-</span>
          </div>
          <div class="flex justify-between">
            <span>Durasi:</span>
            <span id="modal-duration" class="text-[#F3F4F6] font-medium">-</span>
          </div>
          <div class="flex justify-between">
            <span>Genre:</span>
            <span id="modal-genre-badge" class="rounded bg-[#263042] px-2 py-0.5 text-amber-400 font-semibold">-</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Title, Synopsis, Reviews, and WhatsApp Action (7 cols) -->
      <div class="md:col-span-7 space-y-6">
        <div>
          <div class="inline-block rounded bg-amber-500/10 px-2.5 py-0.5 text-xs font-medium text-amber-400 border border-amber-500/20 mb-2">
            Detail & Ulasan Kurasi
          </div>
          <h3 id="modal-film-title" class="font-['Cinzel'] text-2xl sm:text-3xl font-extrabold text-[#F3F4F6]">
            Judul Film
          </h3>
        </div>

        <!-- Synopsis -->
        <div class="space-y-1.5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#9CA3AF]">
            Sinopsis Lengkap
          </h4>
          <p id="modal-synopsis" class="text-sm text-[#F3F4F6]/90 leading-relaxed font-normal">
            Sinopsis film...
          </p>
        </div>

        <!-- Curator Note -->
        <div class="rounded-xl border border-amber-500/25 bg-amber-500/5 p-4 space-y-1">
          <div class="flex items-center gap-1.5 text-xs font-bold text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <span>Catatan Kurator CineVault</span>
          </div>
          <p id="modal-curator-note" class="text-xs text-[#9CA3AF] italic leading-relaxed">
            Catatan kurator...
          </p>
        </div>

        <!-- Community Review Highlight -->
        <div class="space-y-2 border-t border-[#263042] pt-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#9CA3AF]">
            Ulasan Pilihan Komunitas
          </h4>
          <div class="rounded-lg bg-[#090A0F] p-3.5 border border-[#263042]/50 space-y-1">
            <div class="flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <span id="modal-review-author" class="font-bold text-[#F3F4F6]">-</span>
                <span id="modal-review-role" class="text-[11px] text-[#9CA3AF]">-</span>
              </div>
              <span id="modal-review-score" class="text-amber-400 font-bold">★ 9.0</span>
            </div>
            <p id="modal-review-text" class="text-xs text-[#9CA3AF] italic">
              "Kutipan ulasan pengguna..."
            </p>
          </div>
        </div>

        <!-- Direct WhatsApp CTA Action -->
        <div class="pt-2">
          <a
            id="modal-wa-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[46px] w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-md hover:bg-emerald-500 transition-all focus-visible:ring-2 focus-visible:ring-emerald-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.79 14.07c-.24.68-1.39 1.3-1.92 1.38-.49.07-1.12.1-3.23-.77-2.69-1.11-4.43-3.84-4.57-4.02-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.94-2.25.24-.27.53-.34.71-.34.18 0 .35.01.5.02.16.01.38-.06.59.45.22.53.75 1.83.82 1.96.07.13.11.29.02.47-.09.18-.14.29-.27.45-.13.16-.28.35-.4.47-.13.13-.27.28-.12.54.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.42.11.58-.07.16-.18.68-.79.86-1.06.18-.27.35-.22.59-.13.24.09 1.5.71 1.76.84.27.13.44.2.5.31.07.11.07.65-.17 1.33z" />
            </svg>
            <span id="modal-wa-label">Diskusikan Film Ini via WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  // Modal controller logic
  const modal = document.getElementById('film-modal');
  const card = document.getElementById('modal-card');
  const closeBtn = document.getElementById('close-modal-btn');
  let previouslyFocusedElement: HTMLElement | null = null;

  function closeModal() {
    if (!modal || !card) return;
    card.classList.remove('scale-100', 'opacity-100');
    card.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (previouslyFocusedElement) {
        previouslyFocusedElement.focus();
      }
    }, 200);
  }

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Listen to open-modal custom event from film catalog
  window.addEventListener('open-film-modal', ((e: CustomEvent) => {
    const film = e.detail;
    if (!film || !modal || !card) return;

    previouslyFocusedElement = document.activeElement as HTMLElement;

    // Populate data
    const titleEl = document.getElementById('modal-film-title');
    const posterEl = document.getElementById('modal-poster') as HTMLImageElement;
    const ratingEl = document.getElementById('modal-rating');
    const directorEl = document.getElementById('modal-director');
    const yearEl = document.getElementById('modal-year');
    const durationEl = document.getElementById('modal-duration');
    const genreEl = document.getElementById('modal-genre-badge');
    const synopsisEl = document.getElementById('modal-synopsis');
    const curatorEl = document.getElementById('modal-curator-note');
    const authorEl = document.getElementById('modal-review-author');
    const roleEl = document.getElementById('modal-review-role');
    const scoreEl = document.getElementById('modal-review-score');
    const reviewTextEl = document.getElementById('modal-review-text');
    const waBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;
    const waLabel = document.getElementById('modal-wa-label');

    if (titleEl) titleEl.textContent = film.title;
    if (posterEl) {
      posterEl.src = film.poster;
      posterEl.alt = `Poster film ${film.title}`;
    }
    if (ratingEl) ratingEl.textContent = film.rating.toString();
    if (directorEl) directorEl.textContent = film.director;
    if (yearEl) yearEl.textContent = film.year.toString();
    if (durationEl) durationEl.textContent = film.duration;
    if (genreEl) genreEl.textContent = film.genre;
    if (synopsisEl) synopsisEl.textContent = film.synopsis;
    if (curatorEl) curatorEl.textContent = `"${film.curatorNote}"`;

    if (film.reviews && film.reviews.length > 0) {
      const firstReview = film.reviews[0];
      if (authorEl) authorEl.textContent = firstReview.author;
      if (roleEl) roleEl.textContent = firstReview.role;
      if (scoreEl) scoreEl.textContent = `★ ${firstReview.rating}`;
      if (reviewTextEl) reviewTextEl.textContent = `"${firstReview.text}"`;
    }

    // Direct WhatsApp link generator with pre-filled message
    if (waBtn) {
      const message = `Halo CineVault, saya ingin berdiskusi mengenai film ${film.title} (${film.year}) yang disutradarai oleh ${film.director}.`;
      waBtn.href = `https://wa.me/6281234567890?text=${encodeURIComponent(message)}`;
    }
    if (waLabel) {
      waLabel.textContent = `Diskusikan ${film.title} via WhatsApp`;
    }

    // Show modal
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      card.classList.remove('scale-95', 'opacity-0');
      card.classList.add('scale-100', 'opacity-100');
      closeBtn?.focus();
    }, 10);
  }) as EventListener);
</script>
