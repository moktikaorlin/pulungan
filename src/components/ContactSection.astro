---
// ContactSection.astro - Kontak Kurator & Formulir Diskusi Cepat
---

<section id="contact" class="relative py-20 border-t border-[#263042]/60 bg-[#090A0F]" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl text-left space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-[#161B26] px-3 py-1 text-xs font-semibold text-amber-400">
        Hubungi Kurator
      </div>
      <h2 id="contact-heading" class="font-['Cinzel'] text-3xl font-extrabold text-[#F3F4F6] sm:text-4xl">
        Kirim Pesan & Terhubung Langsung
      </h2>
      <p class="text-base text-[#9CA3AF]">
        Punya rekomendasi film langka, esai ulasan, atau ingin mengajak kolaborasi program pemutaran? Sampaikan langsung kepada tim kami.
      </p>
    </div>

    <!-- Contact Grid: Info (5 cols) & Form (7 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Community Info & WhatsApp Direct -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-2xl border border-[#263042] bg-[#161B26] p-7 space-y-6">
          <h3 class="font-['Outfit'] text-xl font-bold text-[#F3F4F6]">
            Informasi Komunitas
          </h3>

          <div class="space-y-5 text-sm">
            <!-- Location -->
            <div class="flex items-start gap-3.5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#090A0F] border border-[#263042] text-amber-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[#F3F4F6]">Basis Komunitas</p>
                <p class="text-xs text-[#9CA3AF] mt-0.5 leading-relaxed">
                  Surabaya Creative Hub, Jl. Gayung Kebonsari No. 56, Surabaya, Jawa Timur
                </p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-3.5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#090A0F] border border-[#263042] text-amber-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[#F3F4F6]">Email Resmi</p>
                <a href="mailto:hello@cinevault.id" class="text-xs text-amber-400 hover:underline mt-0.5 block">
                  hello@cinevault.id
                </a>
              </div>
            </div>

            <!-- WhatsApp Active -->
            <div class="flex items-start gap-3.5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#090A0F] border border-[#263042] text-emerald-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.79 14.07c-.24.68-1.39 1.3-1.92 1.38-.49.07-1.12.1-3.23-.77-2.69-1.11-4.43-3.84-4.57-4.02-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.94-2.25.24-.27.53-.34.71-.34.18 0 .35.01.5.02.16.01.38-.06.59.45.22.53.75 1.83.82 1.96.07.13.11.29.02.47-.09.18-.14.29-.27.45-.13.16-.28.35-.4.47-.13.13-.27.28-.12.54.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.42.11.58-.07.16-.18.68-.79.86-1.06.18-.27.35-.22.59-.13.24.09 1.5.71 1.76.84.27.13.44.2.5.31.07.11.07.65-.17 1.33z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[#F3F4F6]">WhatsApp Kurator Aktif</p>
                <p class="text-xs text-[#9CA3AF] mt-0.5">
                  +62 812-3456-7890 (Senin s/d Sabtu, 10:00 s/d 21:00 WIB)
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Direct WhatsApp Quick Chat Pill -->
        <a
          href="https://wa.me/6281234567890?text=Halo%20CineVault%2C%20saya%20ingin%20berdiskusi%20mengenai%20rekomendasi%20film."
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-[46px] items-center justify-between rounded-xl border border-emerald-500/30 bg-[#161B26] p-4 text-emerald-400 hover:border-emerald-500 hover:bg-[#1F2737] transition-all"
        >
          <div class="flex items-center gap-3">
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs font-bold text-[#F3F4F6]">Kurator Sedang Online</span>
          </div>
          <span class="text-xs font-semibold text-emerald-400">Chat WhatsApp Langsung &rarr;</span>
        </a>
      </div>

      <!-- Right Column: Quick Discussion Form (Direct to WhatsApp) -->
      <div class="lg:col-span-7">
        <form
          id="quick-contact-form"
          class="rounded-2xl border border-[#263042] bg-[#161B26] p-7 sm:p-8 space-y-5 shadow-xl"
        >
          <div>
            <h3 class="font-['Outfit'] text-xl font-bold text-[#F3F4F6]">
              Formulir Pesan Cepat ke WhatsApp
            </h3>
            <p class="text-xs text-[#9CA3AF] mt-1">
              Data yang Anda isi akan dirangkai menjadi pesan terstruktur dan langsung diarahkan ke nomor kurator CineVault.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Name Input -->
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-[#9CA3AF]">
                Nama Lengkap <span class="text-amber-400">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Nama Anda"
                class="w-full min-h-[44px] rounded-lg border border-[#263042] bg-[#090A0F] px-3.5 py-2 text-sm text-[#F3F4F6] placeholder:text-[#9CA3AF]/40 focus-visible:border-amber-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber-400"
              />
            </div>

            <!-- Email Input -->
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-[#9CA3AF]">
                Alamat Email <span class="text-amber-400">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="nama@email.com"
                class="w-full min-h-[44px] rounded-lg border border-[#263042] bg-[#090A0F] px-3.5 py-2 text-sm text-[#F3F4F6] placeholder:text-[#9CA3AF]/40 focus-visible:border-amber-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber-400"
              />
            </div>
          </div>

          <!-- Topic / Film Selection -->
          <div class="space-y-1.5">
            <label for="contact-topic" class="block text-xs font-semibold uppercase tracking-wider text-[#9CA3AF]">
              Topik Diskusi / Judul Film <span class="text-amber-400">*</span>
            </label>
            <input
              type="text"
              id="contact-topic"
              name="topic"
              required
              placeholder="Contoh: Diskusi Film Past Lives atau Rekomendasi Arthouse"
              class="w-full min-h-[44px] rounded-lg border border-[#263042] bg-[#090A0F] px-3.5 py-2 text-sm text-[#F3F4F6] placeholder:text-[#9CA3AF]/40 focus-visible:border-amber-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber-400"
            />
          </div>

          <!-- Message Textarea -->
          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-[#9CA3AF]">
              Isi Catatan atau Ulasan Singkat <span class="text-amber-400">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Tuliskan catatan diskusi, ulasan, atau pertanyaan Anda untuk kurator di sini..."
              class="w-full rounded-lg border border-[#263042] bg-[#090A0F] p-3.5 text-sm text-[#F3F4F6] placeholder:text-[#9CA3AF]/40 focus-visible:border-amber-400 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber-400"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-contact-btn"
            class="flex min-h-[46px] w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 px-6 py-3 text-sm font-bold text-[#090A0F] shadow-md hover:from-amber-400 hover:to-amber-500 focus-visible:ring-2 focus-visible:ring-amber-300 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.79 14.07c-.24.68-1.39 1.3-1.92 1.38-.49.07-1.12.1-3.23-.77-2.69-1.11-4.43-3.84-4.57-4.02-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.94-2.25.24-.27.53-.34.71-.34.18 0 .35.01.5.02.16.01.38-.06.59.45.22.53.75 1.83.82 1.96.07.13.11.29.02.47-.09.18-.14.29-.27.45-.13.16-.28.35-.4.47-.13.13-.27.28-.12.54.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.42.11.58-.07.16-.18.68-.79.86-1.06.18-.27.35-.22.59-.13.24.09 1.5.71 1.76.84.27.13.44.2.5.31.07.11.07.65-.17 1.33z" />
            </svg>
            <span>Buka Obrolan WhatsApp dengan Kurator</span>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  // Form submission handler to generate WhatsApp link
  const contactForm = document.getElementById('quick-contact-form') as HTMLFormElement;

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const topicInput = document.getElementById('contact-topic') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

    const name = nameInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';
    const topic = topicInput?.value.trim() || '';
    const message = messageInput?.value.trim() || '';

    if (!name || !email || !topic || !message) {
      alert('Mohon lengkapi seluruh kolom formulir sebelum mengirim.');
      return;
    }

    const formattedMessage = `Halo CineVault, nama saya ${name} (${email}).\n\nSaya ingin berdiskusi mengenai: ${topic}.\n\nCatatan:\n${message}`;
    const waUrl = `https://wa.me/6281234567890?text=${encodeURIComponent(formattedMessage)}`;

    window.open(waUrl, '_blank', 'noopener,noreferrer');
  });
</script>
