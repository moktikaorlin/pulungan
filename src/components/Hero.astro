---
// Hero.astro - CineVault Hero Section
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32" aria-labelledby="hero-title">
  <!-- Subtle Cinematic Vignette Effect -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center_top,rgba(245,158,11,0.08)_0%,rgba(9,10,15,0.95)_70%)]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      
      <!-- Left Content Column (7 cols) -->
      <div class="lg:col-span-7 space-y-8 text-left">
        <!-- Film Identity Tag -->
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/25 bg-[#161B26]/80 px-3.5 py-1.5 text-xs font-semibold text-amber-400">
          <span class="inline-block h-2 w-2 rounded-full bg-amber-400"></span>
          <span>Jurnal Sinema & Komunitas Kurasi</span>
        </div>

        <!-- H1 Headline -->
        <h1 id="hero-title" class="font-['Cinzel'] text-4xl font-extrabold tracking-tight text-[#F3F4F6] sm:text-5xl lg:text-6xl leading-[1.12]">
          Track, Review, and Curate Your <span class="bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent">Cinematic Journey.</span>
        </h1>

        <!-- Subheadline -->
        <p class="max-w-2xl text-base text-[#9CA3AF] sm:text-lg leading-relaxed font-normal">
          Ruang digital elegan untuk mencatat film yang telah ditonton, membagikan ulasan personal, dan menjelajahi arsip sinema lintas dekade dengan antarmuka yang bersih.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href="#catalog"
            class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 px-7 py-3 text-sm font-bold text-[#090A0F] shadow-lg shadow-amber-500/10 hover:from-amber-400 hover:to-amber-500 hover:shadow-amber-500/25 transition-all focus-visible:ring-2 focus-visible:ring-amber-300"
          >
            <span>Jelajahi Katalog Film</span>
          </a>

          <a
            href="https://wa.me/6281234567890?text=Halo%20CineVault%2C%20saya%20ingin%20bergabung%20dengan%20komunitas%20cinephile%20dan%20diskusi%20kurator."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-[#263042] bg-[#161B26] px-6 py-3 text-sm font-semibold text-[#F3F4F6] hover:border-emerald-500/50 hover:bg-[#1F2737] hover:text-emerald-300 transition-all focus-visible:ring-2 focus-visible:ring-amber-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2.5 h-4 w-4 fill-emerald-400" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm5.79 14.07c-.24.68-1.39 1.3-1.92 1.38-.49.07-1.12.1-3.23-.77-2.69-1.11-4.43-3.84-4.57-4.02-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.94-2.25.24-.27.53-.34.71-.34.18 0 .35.01.5.02.16.01.38-.06.59.45.22.53.75 1.83.82 1.96.07.13.11.29.02.47-.09.18-.14.29-.27.45-.13.16-.28.35-.4.47-.13.13-.27.28-.12.54.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.42.11.58-.07.16-.18.68-.79.86-1.06.18-.27.35-.22.59-.13.24.09 1.5.71 1.76.84.27.13.44.2.5.31.07.11.07.65-.17 1.33z" />
            </svg>
            <span>Gabung Komunitas WhatsApp</span>
          </a>
        </div>

        <!-- Practical Proof Highlights (Real features) -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-[#263042]/60">
          <div>
            <p class="font-['Outfit'] text-2xl font-bold text-[#F3F4F6]">8 Judul</p>
            <p class="text-xs text-[#9CA3AF] mt-0.5">Kurasi Pilihan Arthouse</p>
          </div>
          <div>
            <p class="font-['Outfit'] text-2xl font-bold text-amber-400">5 Genre</p>
            <p class="text-xs text-[#9CA3AF] mt-0.5">Filter Interaktif Seketika</p>
          </div>
          <div>
            <p class="font-['Outfit'] text-2xl font-bold text-rose-400">1-Klik</p>
            <p class="text-xs text-[#9CA3AF] mt-0.5">Diskusi Langsung Kurator</p>
          </div>
        </div>
      </div>

      <!-- Right Visual Column (5 cols): Cinematic Depth-of-field Poster Composition -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-md mx-auto aspect-[4/5] flex items-center justify-center">
          
          <!-- Background Blurred Poster (Depth of field effect) -->
          <div class="absolute -left-6 top-8 w-56 h-80 rounded-xl overflow-hidden shadow-2xl border border-[#263042]/50 opacity-40 blur-[1px] rotate-[-6deg] transition-transform duration-500 hover:rotate-[-4deg]">
            <img
              src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=400&q=75"
              alt="Poster sinema Blade Runner bernuansa neon distopia"
              width="400"
              height="600"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Secondary Right Blurred Poster -->
          <div class="absolute -right-6 top-12 w-56 h-80 rounded-xl overflow-hidden shadow-2xl border border-[#263042]/50 opacity-40 blur-[1px] rotate-[8deg] transition-transform duration-500 hover:rotate-[6deg]">
            <img
              src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=400&q=75"
              alt="Poster sinema thriller bernuansa arsitektur minimalis"
              width="400"
              height="600"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Foreground Main Featured Card (High Priority for Performance R-40) -->
          <div class="relative z-20 w-64 sm:w-72 rounded-2xl overflow-hidden border border-amber-500/30 bg-[#161B26] shadow-2xl shadow-black/80 transition-transform duration-300 hover:scale-[1.02]">
            <div class="relative aspect-[2/3] w-full overflow-hidden bg-[#090A0F]">
              <img
                src="https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?auto=format&fit=crop&w=600&q=85"
                alt="Poster film pilihan Past Lives dengan panorama kota senja"
                width="600"
                height="900"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#161B26] via-transparent to-transparent"></div>
              
              <!-- Live Journal Tag -->
              <div class="absolute top-3 left-3 rounded-md bg-[#090A0F]/80 backdrop-blur-sm px-2.5 py-1 text-[11px] font-semibold text-amber-400 border border-amber-500/20">
                Log Hari Ini
              </div>

              <!-- Rating Badge -->
              <div class="absolute top-3 right-3 flex items-center gap-1 rounded-md bg-amber-500 px-2 py-0.5 text-xs font-bold text-[#090A0F]">
                <span>★</span>
                <span>8.8</span>
              </div>
            </div>

            <!-- Card Bottom Information -->
            <div class="p-4 space-y-2 bg-[#161B26]">
              <div class="flex items-center justify-between text-xs text-[#9CA3AF]">
                <span>Celine Song (2023)</span>
                <span class="rounded bg-[#263042] px-2 py-0.5 text-[#F3F4F6]">Drama</span>
              </div>
              <h2 class="font-['Outfit'] text-lg font-bold text-[#F3F4F6] line-clamp-1">
                Past Lives
              </h2>
              <p class="text-xs text-[#9CA3AF] line-clamp-2 italic">
                "Meditasi yang jujur tentang waktu, takdir, dan kesempatan yang terlewatkan."
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
