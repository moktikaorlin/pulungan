---
// Testimonials.astro - Ulasan & Testimoni Komunitas Cinephile
const testimonials = [
  {
    name: 'Arisandi Wardhana',
    role: 'Kurator Sinema Alternatif',
    badge: 'Kurator Terverifikasi',
    badgeColor: 'border-amber-500/30 text-amber-400 bg-amber-500/10',
    avatarInitials: 'AW',
    favorite: 'Past Lives (2023)',
    quote: 'Sebagai kurator pemutaran film independen, saya membutuhkan ruang pencatatan yang bebas dari algoritma iklan komersial. CineVault memberikan pengalaman jurnal sinema yang hening dan mempermudah diskusi kurasi dua arah.'
  },
  {
    name: 'Maya Lestari',
    role: 'Penulis Jurnal Film & Arsiparis',
    badge: 'Beta Cinephile',
    badgeColor: 'border-rose-500/30 text-rose-400 bg-rose-500/10',
    avatarInitials: 'ML',
    favorite: 'Fire of Love (2022)',
    quote: 'Antarmukanya tenang, gelap, dan sangat nyaman untuk membaca ulasan panjang di malam hari. Format katalog tematik memudahkan saya mendokumentasikan impresi estetika film demi film.'
  },
  {
    name: 'Reza Aditya',
    role: 'Sutradara Film Pendek',
    badge: 'Kreator Terverifikasi',
    badgeColor: 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10',
    avatarInitials: 'RA',
    favorite: 'Mad Max: Fury Road (2015)',
    quote: 'Daftar kurasi tematik sangat membantu proses pra-produksi kami saat menyusun daftar referensi blocking dan tata visual. Fitur tautan diskusi langsung ke WhatsApp mempercepat kolaborasi ide kreatif.'
  }
];
---

<section id="community" class="relative py-20 border-t border-[#263042]/60 bg-[#090A0F]" aria-labelledby="community-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="max-w-2xl text-left space-y-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-[#161B26] px-3 py-1 text-xs font-semibold text-amber-400">
        Ulasan & Suara Komunitas
      </div>
      <h2 id="community-heading" class="font-['Cinzel'] text-3xl font-extrabold text-[#F3F4F6] sm:text-4xl">
        Dipercaya oleh Penikmat & Kritikus Film
      </h2>
      <p class="text-base text-[#9CA3AF]">
        Pengalaman langsung dari para penonton, arsiparis, dan sutradara yang telah mengadopsi CineVault sebagai jurnal tontonan harian.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <article class="flex flex-col justify-between rounded-xl border border-[#263042] bg-[#161B26] p-7 shadow-lg transition-all duration-300 hover:border-amber-500/30 hover:-translate-y-1">
          <div class="space-y-4">
            <!-- Reviewer Header -->
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <!-- Simple geometric initial avatar (R-23 compliant) -->
                <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#090A0F] border border-[#263042] text-sm font-bold text-amber-400">
                  {item.avatarInitials}
                </div>
                <div>
                  <h3 class="font-['Outfit'] text-base font-bold text-[#F3F4F6]">
                    {item.name}
                  </h3>
                  <p class="text-xs text-[#9CA3AF]">
                    {item.role}
                  </p>
                </div>
              </div>
            </div>

            <!-- Status Badge -->
            <div>
              <span class={`inline-block rounded-full px-2.5 py-0.5 text-[11px] font-semibold border ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-sm text-[#F3F4F6]/90 italic leading-relaxed pt-1">
              "{item.quote}"
            </p>
          </div>

          <!-- Favorite Film Log Tag -->
          <div class="mt-6 pt-4 border-t border-[#263042]/70 flex items-center justify-between text-xs">
            <span class="text-[#9CA3AF]">Log Terakhir:</span>
            <span class="font-medium text-amber-400">{item.favorite}</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Community Callout Banner -->
    <div class="rounded-2xl border border-amber-500/25 bg-gradient-to-r from-[#161B26] via-[#1A2232] to-[#161B26] p-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="font-['Outfit'] text-2xl font-bold text-[#F3F4F6]">
          Ingin Membagikan Ulasan Sinema Anda?
        </h3>
        <p class="text-sm text-[#9CA3AF] max-w-xl">
          Bergabunglah dalam lingkaran diskusi tertutup CineVault di WhatsApp dan tukar pandangan dengan sesama pemerhati film.
        </p>
      </div>

      <a
        href="https://wa.me/6281234567890?text=Halo%20CineVault%2C%20saya%20ingin%20mengirimkan%20esai%20ulasan%20film%20untuk%20dikurasi."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-amber-500 px-6 py-2.5 text-xs font-bold text-[#090A0F] hover:bg-amber-400 transition-all focus-visible:ring-2 focus-visible:ring-amber-300 whitespace-nowrap"
      >
        Gabung Diskusi WhatsApp
      </a>
    </div>

  </div>
</section>
